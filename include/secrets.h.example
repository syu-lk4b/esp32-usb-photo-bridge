#pragma once

// ---------------------------------------------------------------------------
// Copy this file to include/secrets.h and fill in your own values.
// include/secrets.h is git-ignored and must never be committed.
// ---------------------------------------------------------------------------

// 2.4 GHz Wi-Fi only - the ESP32-S3 has no 5 GHz radio.
#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASS "your-wifi-password"

// Optional HTTP Basic auth for the web UI and every API endpoint.
// Leave WEB_PASS empty ("") to disable auth (LAN-only setups).
#define WEB_USER "admin"
#define WEB_PASS ""

// Optional static IP. Leave all three empty to use DHCP.
#define STATIC_IP   ""
#define STATIC_GW   ""
#define STATIC_MASK ""

// mDNS hostname -> http://photo-frame.local
// Change it if you run more than one bridge on the same LAN.
#define MDNS_HOST "photo-frame"
